<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claude.guard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/claude-guard.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>CLAUDE_GUARD_GRACE</key>
        <string>15</string>
        <!-- TUN 或系统代理被关时，也视为“不可用”并立刻杀 Claude。
             只想要其一，删掉对应那行即可；两者都要就都留着。 -->
        <key>CLAUDE_GUARD_REQUIRE_TUN</key>
        <string>1</string>
        <key>CLAUDE_GUARD_REQUIRE_SYSPROXY</key>
        <string>1</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/var/log/claude-guard.out.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/claude-guard.err.log</string>
</dict>
</plist>
